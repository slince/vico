{
  "name": "@vico/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "debug": "tsx %NODE_DEBUG_OPTION% src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "skill:install": "tsx src/skill/install.ts",
    "eval:ci": "tsx src/agent/evals/ci-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1072.0",
    "@aws-sdk/s3-presigned-post": "^3.1072.0",
    "@aws-sdk/s3-request-presigner": "^3.1072.0",
    "@hono/node-server": "^2.0.4",
    "@libsql/client": "^0.17.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@vico/agent": "workspace:*",
    "@vico/boot": "workspace:*",
    "@vico/checkpoint": "workspace:*",
    "@vico/checkpoint-libsql": "workspace:*",
    "@vico/compaction": "workspace:*",
    "@vico/di": "workspace:*",
    "@vico/memory-libsql": "workspace:*",
    "@vico/model": "workspace:*",
    "@vico/rag": "workspace:*",
    "@vico/skill": "workspace:*",
    "@vico/thread": "workspace:*",
    "@vico/thread-libsql": "workspace:*",
    "@vico/tool": "workspace:*",
    "@vico/types": "workspace:*",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "ai": "7.0.142",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "files-sdk": "^1.9.0",
    "hono": "^4.12.25",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "uuid": "^10.0.0",
    "ws": "^8.21.3",
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
