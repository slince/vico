{
  "name": "@vico/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "debug": "tsx %NODE_DEBUG_OPTION% src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "skill:install": "tsx src/skill/install.ts",
    "eval:ci": "tsx src/agent/evals/ci-smoke.ts"
  },
  "dependencies": {
    "@vico/core": "workspace:*",
    "@vico/libsql-adapter": "workspace:*",
    "@vico/rag": "workspace:*",
    "@aws-sdk/client-s3": "^3.1072.0",
    "@aws-sdk/s3-presigned-post": "^3.1072.0",
    "@aws-sdk/s3-request-presigner": "^3.1072.0",
    "@hono/node-server": "^2.0.4",
    "@libsql/client": "^0.17.0",
    "@xenova/transformers": "^2.17.2",
    "ai": "7.0.26",
    "better-auth": "^1.6.16",
    "drizzle-orm": "^0.45.2",
    "files-sdk": "^1.9.0",
    "hono": "^4.12.25",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "uuid": "^10.0.0",
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
