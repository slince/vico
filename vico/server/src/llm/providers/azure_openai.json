{
  "id": "azure_openai",
  "name": "Azure OpenAI",
  "name_en": "Azure OpenAI",
  "order": 31,
  "api": "openai-completions",
  "auth": "api-key header",
  "requires_auth": true,
  "base_urls": {
    "chat": "https://{resource}.openai.azure.com",
    "embedding": "https://{resource}.openai.azure.com",
    "vllm": "https://{resource}.openai.azure.com"
  },
  "website": "https://ai.azure.com",
  "thinking": "reasoning_effort; max_completion_tokens",
  "note": "需填 api_version：留空走 /openai/v1 新路径，填写走 deployments 旧路径",
  "model_types": [
    "chat",
    "embedding",
    "vllm"
  ],
  "model_type_labels": [
    "对话",
    "向量",
    "VLM"
  ],
  "model_count": 3,
  "pattern_count": 8,
  "models": [
    {
      "kind": "pattern",
      "match": "gpt-6*",
      "name": "GPT-6 deployments (reasoning, thinking always on)",
      "reasoning": true,
      "input": [
        "text",
        "image"
      ],
      "compat": {
        "supports_temperature": false
      }
    },
    {
