{
  "name": "vico",
  "private": true,
  "scripts": {
    "dev": "pnpm run --recursive dev",
    "build": "pnpm run --recursive build",
    "dev:server": "pnpm --filter @vico/server dev",
    "dev:web": "pnpm --filter @vico/web dev",
    "db:migrate": "pnpm --filter @vico/server db:migrate",
    "skill:install": "pnpm --filter @vico/server skill:install"
  },
  "packageManager": "pnpm@12.11.2"
}
